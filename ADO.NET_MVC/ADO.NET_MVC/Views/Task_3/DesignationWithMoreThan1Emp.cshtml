@model IEnumerable<ADO.NET_MVC.Models.ViewModels.DesignationCountVM>
@{
    ViewBag.Title = "DesignationWithMoreThan1Emp";
}

<h2>Designation Having More than 1 Employee</h2>

<table class="table table-striped">
    <tr>
        <th>Designation</th>
        <th>No. of Employees</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Designation</td>
            <td>@item.EmployeeCount</td>
        </tr>
    }
</table>

<button class="btn btn-warning">@Html.ActionLink("Back", "Index")</button>