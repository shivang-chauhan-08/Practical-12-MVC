@model IEnumerable<ADO.NET_MVC.Models.ViewModels.EmployeeInfoVM>
@{
    ViewBag.Title = "EmployeeInfo";
}

<h2>Employee Info With Designation</h2>

<table class="table table-striped">
    <tr>
        <th>First Name</th>
        <th>Middle Name</th>
        <th>Last Name</th>
        <th>Designation</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.FirstName</td>
            <td>@item.MiddleName</td>
            <td>@item.LastName</td>
            <td>@item.Designation</td>
        </tr>
    }
</table>

<button class="btn btn-warning">@Html.ActionLink("Back", "Index")</button>